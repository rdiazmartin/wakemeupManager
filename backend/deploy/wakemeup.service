[Unit]
Description=wakemeupManager backend - control de máquinas de la red via WOL/SSH
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
User=wakemeup
Group=wakemeup
WorkingDirectory=/var/lib/wakemeup
Environment=WAKEMEUP_DB__PATH=/var/lib/wakemeup/wakemeup.db
# Intérprete del venv gestionado por `uv` (nunca el Python de sistema 3.11);
# el runner `wakemeup.server` bindea `[api] bind_hosts` (tailnet + loopback)
# y tolera que la interfaz tailnet aparezca tarde.
ExecStart=/opt/wakemeup/backend/.venv/bin/python -m wakemeup.server
Restart=always
RestartSec=5
# Hardening básico (sin ProtectHome: el venv/binario de uv vive en /opt).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wakemeup

[Install]
WantedBy=multi-user.target
