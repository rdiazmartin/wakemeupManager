[Unit]
Description=wakemeupManager backend - control de máquinas de la red via WOL/SSH
Wants=network-online.target
After=network-online.target

[Service]
User=wakemeup
Group=wakemeup
WorkingDirectory=/var/lib/wakemeup
# TODO(4.1): fijar la IP/interface tailnet real como host (AD-6) y la ruta
# final del binario/venv gestionado por uv (AD-7); aquí referencia local.
ExecStart=/home/wakemeup/.local/bin/uv run --project /opt/wakemeup/backend uvicorn wakemeup.api:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
# Hardening básico (sin ProtectHome: el binario de uv vive en ~wakemeup/.local)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wakemeup

[Install]
WantedBy=multi-user.target
